rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDeviceId(id) {
      return id is string && id.size() >= 4 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Matches either the authenticated Firebase user (Google or Anonymous Auth)
    // or a valid device identifier fallback when working in unauthenticated/guest classroom mode.
    function isOwner(ownerId) {
      return (isSignedIn() && (ownerId == request.auth.uid || isValidDeviceId(ownerId)))
        || (!isSignedIn() && isValidDeviceId(ownerId));
    }

    function isSessionHost(sessionId) {
      let sessionData = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      return isOwner(sessionData.hostId);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Teacher user profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow create, update: if isSignedIn() && (request.auth.uid == userId)
        && incoming().uid == request.auth.uid;
      allow delete: if false;
    }

    // Quizzes created by teachers or shared publicly
    match /quizzes/{quizId} {
      allow get: if resource.data.isPublic == true || isOwner(resource.data.ownerId);
      allow list: if resource.data.isPublic == true || isOwner(resource.data.ownerId);
      allow create: if isValidId(quizId)
        && isOwner(incoming().ownerId)
        && incoming().title is string && incoming().title.size() <= 300;
      allow update: if isValidId(quizId)
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().title is string && incoming().title.size() <= 300;
      allow delete: if isValidId(quizId)
        && isOwner(existing().ownerId);
    }

    // Live Quiz Sessions
    match /sessions/{sessionId} {
      allow get: if true;
      // Only allow small bounded queries (such as findSessionByPin with limit(5)) to prevent bulk scraping
      allow list: if request.query.limit <= 5;

      allow create: if isValidId(sessionId)
        && incoming().pin is string && incoming().pin.size() == 6
        && isOwner(incoming().hostId);

      // Only the session host can update or advance the session state; hostId and pin are immutable
      allow update: if isValidId(sessionId)
        && isOwner(existing().hostId)
        && incoming().hostId == existing().hostId
        && incoming().pin == existing().pin;

      allow delete: if isValidId(sessionId)
        && isOwner(existing().hostId);

      // Private host-only subcollection storing unredacted answer keys (hidden from students)
      match /private/{docId} {
        allow get: if isSessionHost(sessionId);
        allow list: if false;
        allow create: if isValidId(docId) && isOwner(incoming().hostId);
        allow update, delete: if isSessionHost(sessionId);
      }

      // Players subcollection within the session
      match /players/{playerId} {
        allow get, list: if true;

        // New players must start at score 0 and streak 0
        allow create: if isValidId(playerId)
          && incoming().nickname is string
          && incoming().nickname.size() >= 1
          && incoming().nickname.size() <= 40
          && incoming().sessionId == sessionId
          && incoming().score == 0
          && incoming().streak == 0
          && (!('uid' in incoming()) || isOwner(incoming().uid));

        // Only the authoritative session host can update player scores/streaks or remove players
        allow update, delete: if isSessionHost(sessionId);
      }

      // Answers subcollection within the session
      match /answers/{answerId} {
        allow get, list: if true;

        // Students can only submit raw ungraded answers (pointsAwarded == 0, isCorrect == false)
        // once per question while the session is actively accepting answers for that question
        allow create: if isValidId(answerId)
          && incoming().sessionId == sessionId
          && incoming().playerId is string
          && incoming().questionIndex is int
          && incoming().pointsAwarded == 0
          && incoming().isCorrect == false
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'question'
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.isAcceptingAnswers == true
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.currentQuestionIndex == incoming().questionIndex;

        // Only the authoritative session host can grade answers (set isCorrect and pointsAwarded) or delete them on restart
        allow update, delete: if isSessionHost(sessionId);
      }
    }

    // Consolidated historical reports for teachers (works both with Google login and device ID)
    match /reports/{reportId} {
      allow get, list: if isOwner(resource.data.teacherId);
      allow create: if isValidId(reportId)
        && isOwner(incoming().teacherId);
      allow update, delete: if isValidId(reportId)
        && isOwner(existing().teacherId);
    }
  }
}
