rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Teacher user profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow create, update: if isSignedIn() && (request.auth.uid == userId)
        && incoming().uid == request.auth.uid;
      allow delete: if false;
    }

    // Quizzes created by teachers or shared
    match /quizzes/{quizId} {
      allow get, list: if resource.data.isPublic == true
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || resource.data.ownerId == 'guest';
      allow create: if isValidId(quizId)
        && (
          (isSignedIn() && incoming().ownerId == request.auth.uid) ||
          incoming().ownerId == 'guest'
        )
        && incoming().title is string && incoming().title.size() <= 150;
      allow update: if isValidId(quizId)
        && (
          (isSignedIn() && existing().ownerId == request.auth.uid) ||
          existing().ownerId == 'guest'
        )
        && incoming().title is string && incoming().title.size() <= 150;
      allow delete: if isValidId(quizId)
        && (
          (isSignedIn() && existing().ownerId == request.auth.uid) ||
          existing().ownerId == 'guest'
        );
    }

    // Live Quiz Sessions
    match /sessions/{sessionId} {
      allow get, list: if true;

      allow create: if isValidId(sessionId)
        && incoming().pin is string && incoming().pin.size() == 6
        && (
          (isSignedIn() && incoming().hostId == request.auth.uid) ||
          incoming().hostId is string
        );

      allow update: if isValidId(sessionId)
        && (
          (isSignedIn() && existing().hostId == request.auth.uid)
          || existing().hostId == 'prof_local'
          || (incoming().diff(existing()).affectedKeys().hasOnly([
              'timeRemaining',
              'lastActivityAt',
              'status',
              'currentQuestionIndex',
              'showingResults',
              'showingPodium',
              'isAcceptingAnswers',
              'questionStartedAt',
              'timeLimitSeconds'
            ]))
        );

      allow delete: if isValidId(sessionId)
        && (
          (isSignedIn() && existing().hostId == request.auth.uid)
          || existing().hostId == 'prof_local'
        );

      // Players subcollection within the session
      match /players/{playerId} {
        allow get, list: if true;
        allow create: if isValidId(playerId)
          && incoming().nickname is string && incoming().nickname.size() <= 40
          && incoming().sessionId == sessionId;
        allow update: if isValidId(playerId)
          && incoming().sessionId == sessionId;
        allow delete: if (isSignedIn() && get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostId == request.auth.uid)
          || get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostId == 'prof_local';
      }

      // Answers subcollection within the session
      match /answers/{answerId} {
        allow get, list: if true;
        allow create: if isValidId(answerId)
          && incoming().sessionId == sessionId;
        allow update: if false;
        allow delete: if (isSignedIn() && get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostId == request.auth.uid)
          || get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostId == 'prof_local';
      }
    }

    // Consolidated historical reports for teachers
    match /reports/{reportId} {
      allow get, list: if (isSignedIn() && resource.data.teacherId == request.auth.uid)
        || resource.data.teacherId == 'prof_local'
        || resource.data.teacherId == 'guest';
      allow create: if isValidId(reportId) && (
        (isSignedIn() && incoming().teacherId == request.auth.uid)
        || incoming().teacherId == 'prof_local'
        || incoming().teacherId == 'guest'
      );
      allow update, delete: if isValidId(reportId) && (
        (isSignedIn() && existing().teacherId == request.auth.uid)
        || existing().teacherId == 'prof_local'
        || existing().teacherId == 'guest'
      );
    }
  }
}
